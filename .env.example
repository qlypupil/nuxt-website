# ============================================
# 环境变量模板 - 复制为 .env 或 .env.local 使用
# 各环境推荐值见 docs/ENV.md
# ============================================

# ---------- 通用 ----------
# 后端接口基础 URL（请求接口时拼接）
NUXT_PUBLIC_API_BASE=

# 站点公开 URL（SEO、sitemap、hreflang、i18n baseUrl）
NUXT_PUBLIC_SITE_URL=http://localhost:4000

# ---------- Nitro 服务器（nuxt preview / 生产运行） ----------
NITRO_HOST=127.0.0.1
NITRO_PORT=4000
